import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';

const mockHandleSignal = vi.fn().mockResolvedValue({
  transitioned: true,
  previousState: 'INIT',
  newState: 'PHASE_1',
  event: { id: '01a06e96-new-event-id' },
  handledAtDepth: 0,
  deliverablesWritten: [],
});

vi.mock('@reactive-skills/runtime', () => ({
  createSortableId: vi.fn(() => '01a06e96-test-sortable-id'),
  FSMEngine: vi.fn().mockImplementation(() => ({
    handleSignal: mockHandleSignal,
    generatePromptSlice: vi.fn(() => ({
      rawPrompt: 'Phase 1 instructions',
      allowedTools: ['run_command'],
      exitConditions: ['PHASE_1_DONE'],
    })),
    getEventStore: vi.fn(() => ({
      getAll: vi.fn(() => [
        { id: '01a06e96-auto-causation-event-id', type: 'SKILL_INITIALIZED' },
      ]),
    })),
    close: vi.fn(),
  })),
}));

describe('emitCommand', () => {
  let originalCwd: string;
  let tmpDir: string;

  beforeEach(() => {
    originalCwd = process.cwd();
    vi.clearAllMocks();
    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'reactive-emit-unit-'));
    process.chdir(tmpDir);
  });

  afterEach(() => {
    process.chdir(originalCwd);
    if (fs.existsSync(tmpDir)) {
      const relative = path.relative(fs.realpathSync(os.tmpdir()), fs.realpathSync(tmpDir));
      if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) throw new Error('Refusing cleanup outside test temporary directory');
      fs.rmSync(tmpDir, { recursive: true, force: true });
    }
  });

  it('returns validation error when missing arguments', async () => {
    const { emitCommand } = await import('../../src/commands/emit.js');
    const result = await emitCommand(['test-skill']);
    expect(result).toContain('error:');
    expect(result).toContain('Missing arguments');
  });

  it('supports 2-arg syntax: emit <skill> <signal> with auto-resolved eventId', async () => {
    const skillDir = path.join(process.cwd(), 'skills', 'test-skill');
    fs.mkdirSync(skillDir, { recursive: true });
    fs.writeFileSync(path.join(skillDir, 'skill.yaml'), 'name: test-skill\nschema_version: 2.0.0\ninitial_state: INIT\nstates:\n  INIT:\n    description: Initial\n');

    const { emitCommand } = await import('../../src/commands/emit.js');
    const result = await emitCommand(['test-skill', 'RUNTIME_READY']);

    expect(mockHandleSignal).toHaveBeenCalledWith(
      'RUNTIME_READY',
      {},
      expect.objectContaining({ causationId: '01a06e96-auto-causation-event-id' })
    );
    expect(result).toContain('emit:');
    expect(result).toContain('signal: RUNTIME_READY');
    expect(result).toContain('current_state: PHASE_1');
  });

  it('supports 3-arg syntax with UUID: emit <skill> <event-id> <signal>', async () => {
    const skillDir = path.join(process.cwd(), 'skills', 'test-skill');
    fs.mkdirSync(skillDir, { recursive: true });
    fs.writeFileSync(path.join(skillDir, 'skill.yaml'), 'name: test-skill\nschema_version: 2.0.0\ninitial_state: INIT\nstates:\n  INIT:\n    description: Initial\n');

    const { emitCommand } = await import('../../src/commands/emit.js');
    const explicitEventId = '01a06e96-8414-7c46-bf87-dd09d5547385';
    const result = await emitCommand(['test-skill', explicitEventId, 'RUNTIME_READY']);

    expect(mockHandleSignal).toHaveBeenCalledWith(
      'RUNTIME_READY',
      {},
      expect.objectContaining({ causationId: explicitEventId })
    );
    expect(result).toContain('emit:');
    expect(result).toContain('signal: RUNTIME_READY');
  });

  it('supports payload JSON argument: emit <skill> <signal> \'{"key":"val"}\'', async () => {
    const skillDir = path.join(process.cwd(), 'skills', 'test-skill');
    fs.mkdirSync(skillDir, { recursive: true });
    fs.writeFileSync(path.join(skillDir, 'skill.yaml'), 'name: test-skill\nschema_version: 2.0.0\ninitial_state: INIT\nstates:\n  INIT:\n    description: Initial\n');

    const { emitCommand } = await import('../../src/commands/emit.js');
    const result = await emitCommand(['test-skill', 'RUNTIME_READY', '{"project_type":"greenfield"}']);

    expect(mockHandleSignal).toHaveBeenCalledWith(
      'RUNTIME_READY',
      { project_type: 'greenfield' },
      expect.any(Object)
    );
    expect(result).toContain('emit:');
  });
  const longSignals = ['BASELINE_ESTABLISHED', 'PORTABILITY_CHECKPOINT_ACCEPTED'];
  const payloadForms = ['none', 'positional-json', 'positional-file', 'flag-json', 'flag-file'] as const;

  function seedSkill() {
    const skillDir = path.join(tmpDir, 'skills', 'test-skill');
    fs.mkdirSync(skillDir, { recursive: true });
    fs.writeFileSync(path.join(skillDir, 'skill.yaml'), 'name: test-skill\nschema_version: 2.0.0\ninitial_state: INIT\nstates:\n  INIT:\n    description: Initial\n');
  }

  function payloadArgs(form: typeof payloadForms[number]) {
    const payload = { exit_code: 0, label: 'payload with spaces' };
    const json = JSON.stringify(payload);
    const file = path.join(tmpDir, 'payload with spaces.json');
    fs.writeFileSync(file, json);
    const forms = {
      none: [],
      'positional-json': [json],
      'positional-file': ['@' + file],
      'flag-json': ['--payload', json],
      'flag-file': ['--payload', '@' + file],
    };
    return { args: forms[form], expected: form === 'none' ? {} : payload };
  }

  it.each(longSignals.flatMap(signal => payloadForms.map(form => ({ signal, form }))))(
    'preserves shorthand $signal with $form and forwards job/idempotency',
    async ({ signal, form }) => {
      seedSkill();
      const payload = payloadArgs(form);
      const { emitCommand } = await import('../../src/commands/emit.js');
      const { FSMEngine } = await import('@reactive-skills/runtime');
      const result = await emitCommand([
        'test-skill', signal, ...payload.args, '--job', 'parser-job',
        '--idempotency-key', 'parser-request',
      ]);
      expect(mockHandleSignal).toHaveBeenCalledExactlyOnceWith(signal, payload.expected, {
        source: 'cli', causationId: '01a06e96-auto-causation-event-id',
        idempotencyKey: 'parser-request',
      });
      expect(FSMEngine).toHaveBeenCalledWith(expect.objectContaining({
        jobId: 'parser-job', eventContext: { run_id: 'parser-job' },
      }));
      expect(result).toContain('signal: ' + signal);
    }
  );

  const eventIds = ['01a06e96-8414-7c46-bf87-dd09d5547385', 'legacy_event_123456789012345'];
  it.each(eventIds.flatMap(eventId => payloadForms.map(form => ({ eventId, form }))))(
    'preserves explicit event $eventId with $form',
    async ({ eventId, form }) => {
      seedSkill();
      const payload = payloadArgs(form);
      const { emitCommand } = await import('../../src/commands/emit.js');
      await emitCommand(['test-skill', eventId, 'BASELINE_ESTABLISHED', ...payload.args]);
      expect(mockHandleSignal).toHaveBeenCalledExactlyOnceWith(
        'BASELINE_ESTABLISHED', payload.expected,
        expect.objectContaining({ source: 'cli', causationId: eventId })
      );
    }
  );

  it.each([['{broken'], ['--payload', '{broken']])(
    'rejects malformed long-signal JSON payload %j',
    async (...payload) => {
      seedSkill();
      const { emitCommand } = await import('../../src/commands/emit.js');
      const result = await emitCommand(['test-skill', 'BASELINE_ESTABLISHED', ...payload]);
      expect(result).toContain('VALIDATION_ERROR');
      expect(result).toContain('Invalid JSON payload');
      expect(mockHandleSignal).not.toHaveBeenCalled();
    }
  );

});
