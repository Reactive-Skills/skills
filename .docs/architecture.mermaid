graph TB
    subgraph ClientLayer ["Client & Interaction Layer"]
        CLI["CLI: mutate / mutate-axi"]
        ReactiveAgent["Reactive Agent Harness (MCP / AXI)"]
    end

    subgraph SkillPackage ["Reactive Skill (mutation-tester)"]
        StateChart["Statechart Engine (skill.yaml v2.2.0)"]
        StatePrompts["Isolated State Prompts (states/*.md)"]
        Projections["Deliverables (.docs/mutation-scorecard.md)"]
        StateChart --> StatePrompts
        StateChart --> Projections
    end

    subgraph GoMutationEngine ["Go Mutation Testing Engine (mutate)"]
        Scanner["Target Workspace & Config Detector"]
        DiffScoper["Git Diff Filter (HEAD / staged / commit range)"]
        Parser["Pure-Go Universal Token & Syntax Mutator"]
        WorkerPool["Concurrent Test Runner & In-Place Swap Manager"]
        Reporter["Mutation Scorecard & Telemetry Generator"]

        Scanner --> Parser
        DiffScoper --> Parser
        Parser --> WorkerPool
        WorkerPool --> Reporter
    end

    subgraph TargetCodebase ["Target Codebase Under Test"]
        Sources["Source Files (.go, .ts, .js, .py, .rs)"]
        TestSuite["Test Runner (go test, vitest, pytest, cargo)"]
    end

    CLI --> Scanner
    ReactiveAgent --> StateChart
    StateChart --> CLI
    Parser -.->|"Identifies mutation points"| Sources
    WorkerPool -->|"Atomic in-place swap & rollback"| Sources
    WorkerPool -->|"Executes test suite with timeout"| TestSuite
    Reporter -->|"Produces JSON/Markdown metrics"| Projections
